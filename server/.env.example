# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (patient app, counsellor app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Gemini (server-side only; never put this in a frontend file) ---
GEMINI_API_KEY=
# Any model your key can access, e.g. a current Flash-class model. Not hard-coded.
GEMINI_MODEL=
GEMINI_TTS_MODEL=

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dynamind
# true = in-memory store, data is LOST on restart. Reported in /api/health.
DEMO_MODE=false

# --- Sessions / dashboard access ---
# Signs session tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# If set, /api/dashboard/* requires header "x-access-code: <value>". If empty the
# dashboard is open (development only; the server logs a warning).
COUNSELLOR_ACCESS_CODE=

# --- Safety copy (deployment specific) ---
# Shown to the user when a crisis statement is detected. Put the real local numbers here.
CRISIS_GUIDANCE=If you may be in immediate danger or thinking about harming yourself, please contact your local emergency number or a local crisis line right now, or reach someone you trust who can be with you.
